class Solution {
    public int maxSubArray(int[] nums) {
        // Initialize currentSum and maxGlobal with the first element
        int currentSum = nums[0];
        int maxGlobal = nums[0];

        for (int i = 1; i < nums.length; i++) {
            // Decision: Should we start a new subarray or continue the old one?
            currentSum = Math.max(nums[i], currentSum + nums[i]);
            
            // Update the overall maximum found so far
            if (currentSum > maxGlobal) {
                maxGlobal = currentSum;
            }
        }

        return maxGlobal;
    }
}
